# =============================================================================
# CORE France Project — configuration pour un déploiement Docker.
# Copiez ce fichier en « .env » (à côté de docker-compose.yml) et ajustez.
# docker compose lit ce .env pour la substitution ${...} ET l'injecte dans l'app.
# =============================================================================

# --- Base de données (service `db` du compose) ------------------------------
# Mot de passe root MariaDB et nom de la base. NE PAS mettre DATABASE_URL ici :
# le compose la construit automatiquement vers le service `db`.
# ⚠ Base DISTINCTE du MDT.
DB_PASSWORD=change_moi_en_prod
DB_NAME=core_site

# --- Application ------------------------------------------------------------
# Port exposé sur la machine hôte (http://localhost:APP_PORT). 3001 par défaut
# pour ne pas entrer en conflit avec le MDT (3080).
APP_PORT=3001
# URL publique du site (redirections, OAuth Discord).
APP_URL=http://localhost:3001
# Rejoue le seed idempotent à chaque démarrage (mettre false une fois installé).
SEED_ON_START=true

# --- Connexion Discord (auth uniquement Discord) ----------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# En prod, l'URI de callback doit pointer vers votre domaine public :
#   https://votre-domaine/api/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback
# Token d'un bot Discord (récupère photo/nom d'un membre par son ID).
DISCORD_BOT_TOKEN=

# --- Bootstrap admin --------------------------------------------------------
# À la 1re connexion, ces Discord ID sont rattachés à la fiche CORE_BOOTSTRAP_
# MEMBER_SLUG et reçoivent toutes les permissions.
CORE_BOOTSTRAP_DISCORD_IDS=285824752709533696
CORE_BOOTSTRAP_MEMBER_SLUG=anas36

# --- Liens externes (NEXT_PUBLIC_*) -----------------------------------------
# ⚠ Ces variables sont figées AU BUILD (Next.js les inline dans le bundle).
#   Après modification, il faut REBUILD l'image : `docker compose up -d --build`.
#   Laissées vides, le code applique ses valeurs par défaut.
NEXT_PUBLIC_MDT_URL=
NEXT_PUBLIC_FIVEM_CONNECT_URL=http://cfx.re/join/b7a6p8
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@corefranceproject
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/h693prnx85

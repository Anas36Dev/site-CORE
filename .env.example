# ─────────────────────────────────────────────────────────────
# CORE France Project — variables d'environnement (exemple)
# Copier ce fichier en `.env` puis renseigner les vraies valeurs.
# ─────────────────────────────────────────────────────────────

# Base de données (dev : MySQL XAMPP — base SÉPARÉE du MDT)
DATABASE_URL="mysql://root:@localhost:3306/core_site"

# Session (clé secrète pour signer les cookies — générer une chaîne longue et aléatoire)
SESSION_SECRET="a-changer-chaine-aleatoire-longue"

# Discord OAuth2 (à créer sur https://discord.com/developers/applications)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:3001/api/auth/discord/callback"
# Token d'un bot Discord (peut être le même que le MDT) — récupère photo/nom d'un membre par son ID
DISCORD_BOT_TOKEN=""

# Bootstrap admin : à la 1re connexion, ces Discord ID sont rattachés à la fiche
# CORE_BOOTSTRAP_MEMBER_SLUG (défaut « anas36 ») et reçoivent toutes les permissions.
CORE_BOOTSTRAP_DISCORD_IDS="285824752709533696"
CORE_BOOTSTRAP_MEMBER_SLUG="anas36"

# Liens externes (affichés dans la navigation)
NEXT_PUBLIC_MDT_URL=""
NEXT_PUBLIC_FIVEM_CONNECT_URL="http://cfx.re/join/b7a6p8"
NEXT_PUBLIC_TIKTOK_URL="https://www.tiktok.com/@corefranceproject"
NEXT_PUBLIC_DISCORD_URL="https://discord.gg/h693prnx85"
